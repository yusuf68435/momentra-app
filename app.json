{
  "expo": {
    "name": "Momentra",
    "slug": "momentra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momentra",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uyart.momentra",
      "buildNumber": "6",
      "infoPlist": {
        "NSContactsUsageDescription": "Momentra misafir listesi oluşturmak için kişilerinize erişim ister.",
        "NSCalendarsUsageDescription": "Momentra sürpriz tarihlerini takviminize eklemek için erişim ister.",
        "NSFaceIDUsageDescription": "Momentra gizli mod için Face ID kullanır.",
        "NSCameraUsageDescription": "Momentra profil fotoğrafı ve sürpriz fotoğrafları için kameraya erişim ister.",
        "NSPhotoLibraryUsageDescription": "Momentra profil fotoğrafı ve sürpriz fotoğrafları için galeri erişimi ister.",
        "NSMicrophoneUsageDescription": "Momentra sesli not kayıt etmek için mikrofona erişim ister.",
        "NSPhotoLibraryAddUsageDescription": "Momentra fotoğraflarınızı galerinize kaydeder.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPrivacyTracking": false,
        "NSLocationWhenInUseUsageDescription": "Momentra hava durumu için konumunuza erişim ister."
      },
      "associatedDomains": [
        "applinks:momentra.app",
        "activitycontinuation:momentra.app"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.uyart.momentra",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "momentra.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F0EBE1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7A5C11",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Momentra profil fotoğrafı ve sürpriz fotoğrafları için galeri erişimi ister.",
          "cameraPermission": "Momentra profil fotoğrafı ve sürpriz fotoğrafları için kameraya erişim ister.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Momentra misafir listesi oluşturmak için kişilerinize erişim ister."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Momentra sürpriz tarihlerini takviminize eklemek için erişim ister."
        }
      ],
      "expo-local-authentication",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Momentra hava durumu için konumunuza erişim ister."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f7fb7d3-8da7-4dfd-ad3b-79d88235940f"
      }
    },
    "owner": "yusuf435"
  }
}
