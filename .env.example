# ============================================================================
# Momentra — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to version control (already in .gitignore).
# EXPO_PUBLIC_* vars are embedded into the client bundle — do not put secrets.
# ============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
# Dashboard: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- RevenueCat (REQUIRED for production, optional in dev) -------------------
# Dashboard: https://app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_key_here

# --- Sentry (Optional — error tracking in production) ------------------------
# Dashboard: https://sentry.io
# Leave empty in development — errorTracking.ts no-ops when DSN missing.
EXPO_PUBLIC_SENTRY_DSN=

# --- PostHog (Optional — product analytics) ----------------------------------
# Dashboard: https://posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=

# ============================================================================
# Server-side secrets (NOT in this file)
# ============================================================================
# These live only on Supabase Edge Functions. Set them with:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Required for AI features:
#   - OPENAI_API_KEY  (ai-chat, ai-recommend, ai-timeline, ai-gifts, ai-backup, ai-music, ai-customize-plan)
# ============================================================================
